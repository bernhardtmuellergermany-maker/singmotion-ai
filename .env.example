# Local demonstration only. Node 24 and ffmpeg/ffprobe required.
DEMO_MODE=true
DATA_DIR=.data
# Optional exact browser origin behind a trusted reverse proxy (scheme + host + port).
APP_ORIGIN=
CUSTOMER_CENTS_PER_TEN_SECONDS=299
DEMO_INITIAL_CREDITS_CENTS=1250
GENERATIONS_ENABLED=false
MAX_JOB_PRICE_CENTS=10000
# Optional local-only admin demonstration. Disabled in production regardless.
ADMIN_DEMO_ENABLED=false
ADMIN_DEMO_ACCESS_KEY=
# Future integrations: intentionally not connected in v0.1.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# BytePlus credentials/schema are intentionally unspecified pending verification.

# Separate operator-only live-test preparation. These flags do NOT enable a provider.
# The OmniHuman 2.0 contract gate remains closed regardless of these values.
BYTEPLUS_LIVE_TEST_ENABLED=false
BYTEPLUS_LIVE_TEST_OPERATOR_SECRET=
# Integer micro-USD (1 USD = 1,000,000 micro-USD); zero denies all spending.
# Must cover verified minimum charges, rounding, fixed fees and applicable tax.
BYTEPLUS_LIVE_TEST_MAX_JOB_MICRO_USD=0
BYTEPLUS_LIVE_TEST_MAX_TOTAL_MICRO_USD=0
BYTEPLUS_LIVE_TEST_MAX_DURATION_SECONDS=10
# Do not add real provider credentials until the 2.0 authentication method is verified.

# Railway staging: username is staging; set a random password in Railway only.
STAGING_AUTH_ENABLED=true
STAGING_PASSWORD=

# Separate Payload Super Admin one-test adapter. Never enabled automatically.
# Keep BYTEPLUS_LIVE_TEST_ENABLED=false on Railway. See docs/PAYLOAD_FIRST_TEST.md.
BYTEPLUS_ADMIN_TEST_ENABLED=false
