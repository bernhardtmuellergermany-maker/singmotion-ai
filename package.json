{
  "name": "singmotion-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 -p ${PORT:-3000}",
    "worker": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "cleanup": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/cleanup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
