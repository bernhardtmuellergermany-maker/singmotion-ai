{
  "name": "singmotion-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 -p ${PORT:-3000}",
    "worker": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "cleanup": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/cleanup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.mjs",
    "byteplus:preflight": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/byteplus-preflight.ts",
    "byteplus:live-test": "node --env-file-if-exists=.env.byteplus.local --experimental-strip-types scripts/byteplus-live-test.ts",
    "test:staging": "node scripts/test-staging.mjs",
    "test:volume": "node scripts/test-volume.mjs",
    "r2:check": "node --experimental-strip-types scripts/r2-connectivity.ts",
    "test:byteplus:offline": "node --experimental-strip-types --test tests/preflight-offline.test.ts",
    "byteplus:first-test": "node --env-file-if-exists=.env.first-test.local --experimental-strip-types scripts/byteplus-first-test.ts",
    "byteplus:operator": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/byteplus-operator.ts",
    "test:byteplus:backend": "node --experimental-strip-types --test tests/operator.test.ts",
    "cms": "tsx node_modules/payload/bin.js",
    "cms:provision": "tsx scripts/cms-provision.ts",
    "test:cms": "tsx --test --test-force-exit tests/cms.integration.ts",
    "cms:seed": "tsx scripts/cms-seed.ts",
    "test:cms:browser": "tsx tests/cms.browser.ts",
    "cms:recover-admin": "tsx scripts/cms-recover-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "graphql": "16.14.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "payload": "3.92.0",
    "pino": "9.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
