# Manual, ciphertext-only HiDrive preflight for GitHub #230.
# No application runtime, production database, Stripe, R2 or RSA key.
# Must only run in the *independent* private restore project, never Production.
FROM node:24-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates rclone \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 backupreader \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin backupreader
WORKDIR /opt/singmotion
COPY --chown=10001:10001 lib/ops/backup-segmented-archive.mjs lib/ops/backup-segmented-archive.mjs
COPY --chown=10001:10001 lib/ops/hidrive-committed-reader.mjs lib/ops/hidrive-committed-reader.mjs
COPY --chown=10001:10001 lib/ops/hidrive-readonly-commit-preflight.mjs lib/ops/hidrive-readonly-commit-preflight.mjs
COPY --chown=10001:10001 lib/ops/hidrive-ro-grant-attestation.mjs lib/ops/hidrive-ro-grant-attestation.mjs
COPY --chown=10001:10001 scripts/hidrive-readonly-commit-preflight.mjs scripts/hidrive-readonly-commit-preflight.mjs
USER 10001:10001
ENV HOME=/tmp \
    TMPDIR=/tmp \
    NODE_ENV=production
# No web listener/port. A short, network-idle window permits the owner to
# open Railway's service Console and authorize a NEW read-only HiDrive grant.
# The actual GET-only preflight NEVER runs on startup. After 30 minutes the
# process exits and restart policy NEVER keeps the service stopped.
# Operator command (after confidential config is present):
# node /opt/singmotion/scripts/hidrive-readonly-commit-preflight.mjs --manifest-only
CMD ["sh", "-c", "umask 077; exec sleep 1800"]
