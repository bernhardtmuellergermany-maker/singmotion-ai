# Keep disabled until database migrations and server-side provisioning are complete.
CMS_ENABLED=false
CMS_DATABASE_URL=
PAYLOAD_SECRET=
CMS_ORIGIN=https://your-private-staging-domain.example
# NEVER enable on Railway. Only for loopback HTTP integration tests.
CMS_LOCAL_TEST=false
# DATA_DIR=/app/.data in Railway; public CMS assets use its cms-public subdirectory.
# Temporary bootstrap variables: set only for the manual provisioning command, then remove.
CMS_PROVISION_CONFIRM=
CMS_INITIAL_ADMIN_EMAIL=
CMS_INITIAL_ADMIN_PASSWORD=
CMS_SEED_CONFIRM=
# Unchanged safety flags
DEMO_MODE=true
GENERATIONS_ENABLED=false
ADMIN_DEMO_ENABLED=false
BYTEPLUS_LIVE_TEST_ENABLED=false
BYTEPLUS_FIRST_TEST_ENABLED=false
BYTEPLUS_FIRST_TEST_DOWNLOAD_ENABLED=false
STAGING_AUTH_ENABLED=true
STAGING_PASSWORD=
# One-off interactive recovery only; do not enable persistently on Railway.
CMS_RECOVERY_ENABLED=false
