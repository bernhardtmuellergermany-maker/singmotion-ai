# Separate operator process only. Never load this file into the customer web server.
# Copy to .env.byteplus.local only after reviewing the verification checklist.
# No combination of these flags bypasses the disabled OmniHuman 2.0 adapter.
DEMO_MODE=true
DATA_DIR=.data
BYTEPLUS_LIVE_TEST_ENABLED=false
BYTEPLUS_LIVE_TEST_OPERATOR_SECRET=
BYTEPLUS_LIVE_TEST_MAX_JOB_MICRO_USD=0
BYTEPLUS_LIVE_TEST_MAX_TOTAL_MICRO_USD=0
BYTEPLUS_LIVE_TEST_MAX_DURATION_SECONDS=10
# Provider credential variable names await verified 2.0 authentication documentation.
